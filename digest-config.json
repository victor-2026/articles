      "action": "Mutation Matrix Full v2 / ствол-2 (операторы вглубь)"
    },
    {
      "match": ["vendor", "third-party", "external integration", "contract testing", "platform boundary"],
      "action": "Article 22 (external boundaries) / note-серия"
    },
    {
      "match": ["playwright", "selenium", "appium", "maestro", "codeless", "test generation", "agentic testing"],
      "action": "Кандидат в pilot-каталог (паттерн testRigor/QAEverest: сначала разбор глубины)"
    },
    {
      "match": ["conway", "org design", "team topology", "ownership", "quality gate"],
      "action": "Серия Quality Operating Model (21-27): кросс-ссылка или блок в конец страницы"
    }
  ],  "max_age_days": 7,
  "groq_model": "openai/gpt-oss-120b",
  "rss_timeout": 15,
  "max_per_source": 3,
  "dedup_lookback": 3
